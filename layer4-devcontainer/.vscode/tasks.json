{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-open Claude shell",
      "type": "shell",
      "command": "bash",
      "args": ["--rcfile", "/workspace/.devcontainer/scripts/claude-rc.sh"],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
