{
  "repo": "sun2admin/builder-project",
  "project": "builder-project",
  "analyzed_at": "2026-05-07",
  "purpose": "Example Layer 4 Claude project demonstrating the multi-project workspace architecture.",
  "primary_language": "Python",
  "languages": [
    "python",
    "shell"
  ],
  "runtime_extras": [],
  "runtime_versions": {},
  "dockerfile_base": "node:22-slim",
  "system_packages": [
    "gh",
    "ipykernel",
    "jupyterlab",
    "numpy",
    "pandas",
    "pdfplumber",
    "pymupdf",
    "pypdf",
    "python3-pip",
    "reportlab",
    "weasyprint"
  ],
  "extra_binaries": [],
  "global_js_packages": [
    "@google/gemini-cli",
    "@anthropic-ai/claude-code"
  ],
  "dockerfile_python_installs": [
    "jupyterlab",
    "ipykernel",
    "pdfplumber",
    "pymupdf",
    "pypdf",
    "reportlab",
    "weasyprint",
    "pandas",
    "numpy",
    "playwright",
    "playwright"
  ],
  "dockerfile_go_installs": [],
  "libraries": {
    "node": [],
    "python": [],
    "go": [],
    "rust": []
  },
  "ports": {
    "inbound": [
      8888
    ]
  },
  "external_services": {
    "domains": [
      "api.anthropic.com",
      "claude.ai",
      "marketplace.visualstudio.com",
      "registry.npmjs.org",
      "sentry.io",
      "statsig.com",
      "update.code.visualstudio.com",
      "vscode.blob.core.windows.net"
    ],
    "source": "init-firewall.sh"
  },
  "env_vars": [
    "CLAUDE_CONFIG_DIR",
    "COLORTERM",
    "DEVCONTAINER",
    "NODE_OPTIONS",
    "PATH",
    "PLAYWRIGHT_BROWSERS_PATH",
    "PLAYWRIGHT_CHROMIUM_SANDBOX",
    "SSH_AUTH_SOCK",
    "TERM",
    "TZ"
  ],
  "browser_tools": [],
  "github_api_usage": true,
  "container": {
    "capabilities": [
      "NET_ADMIN",
      "NET_RAW"
    ],
    "volumes": [
      {
        "name": "claude-code-bashhistory-${devcontainerId}",
        "target": "/commandhistory",
        "type": "volume"
      },
      {
        "name": "claude-code-config-${devcontainerId}",
        "target": "/home/claude/.claude",
        "type": "volume"
      },
      {
        "name": "${localEnv:HOME}/Downloads/ClaudeFiles/SharedFiles",
        "target": "/home/claude/data",
        "type": "bind",
        "consistency": "cached"
      },
      {
        "name": "${localEnv:HOME}/Downloads/ClaudeFiles/Config/gh_claude_ed25519",
        "target": "/run/credentials/gh_claude_ed25519",
        "type": "bind",
        "readonly": true
      },
      {
        "name": "${localEnv:HOME}/Downloads/ClaudeFiles/Config/gh_pat",
        "target": "/run/credentials/gh_pat",
        "type": "bind",
        "readonly": true
      }
    ],
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "CLAUDE_CONFIG_DIR": "/home/claude/.claude",
      "SSH_AUTH_SOCK": "/home/claude/.ssh/agent.sock",
      "TERM": "xterm-256color",
      "COLORTERM": "truecolor"
    },
    "remote_user": "claude",
    "post_start": "sudo /usr/local/bin/init-firewall.sh && /workspace/.devcontainer/scripts/init-ssh.sh && /workspace/.devcontainer/scripts/init-gh-token.sh && /workspace/.devcontainer/scripts/init-github-mcp.sh && /workspace/.devcontainer/scripts/load-projects.sh -live sun2admin/builder-project",
    "post_create": "",
    "post_attach": "",
    "post_start_chain": [
      {
        "raw": "sudo /usr/local/bin/init-firewall.sh",
        "sudo": true,
        "script": "/usr/local/bin/init-firewall.sh",
        "args": "",
        "in_repo": false
      },
      {
        "raw": "/workspace/.devcontainer/scripts/init-ssh.sh",
        "sudo": false,
        "script": "/workspace/.devcontainer/scripts/init-ssh.sh",
        "args": "",
        "in_repo": false
      },
      {
        "raw": "/workspace/.devcontainer/scripts/init-gh-token.sh",
        "sudo": false,
        "script": "/workspace/.devcontainer/scripts/init-gh-token.sh",
        "args": "",
        "in_repo": false
      },
      {
        "raw": "/workspace/.devcontainer/scripts/init-github-mcp.sh",
        "sudo": false,
        "script": "/workspace/.devcontainer/scripts/init-github-mcp.sh",
        "args": "",
        "in_repo": false
      },
      {
        "raw": "/workspace/.devcontainer/scripts/load-projects.sh -live sun2admin/builder-project",
        "sudo": false,
        "script": "/workspace/.devcontainer/scripts/load-projects.sh",
        "args": "-live sun2admin/builder-project",
        "in_repo": false
      }
    ],
    "post_create_chain": [],
    "init_scripts": [],
    "extensions": [
      "anthropic.claude-code",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "eamodio.gitlens",
      "ms-toolsai.jupyter"
    ],
    "vscode_settings": {
      "claudeCode.useTerminal": true,
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "terminal.integrated.profiles.linux": {
        "claude-bash": {
          "path": "bash",
          "args": [
            "--rcfile",
            "/workspace/.devcontainer/scripts/claude-rc.sh"
          ]
        }
      },
      "terminal.integrated.defaultProfile.linux": "claude-bash"
    },
    "workspace_mount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
    "workspace_folder": "/workspace",
    "wait_for": "postStartCommand",
    "shutdown_action": "stopContainer"
  },
