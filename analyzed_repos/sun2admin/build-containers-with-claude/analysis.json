{
  "repo": "sun2admin/build-containers-with-claude",
  "project": "build-containers-with-claude",
  "analyzed_at": "2026-05-06",
  "purpose": "Layer 4 Part 1 devcontainer config for building containers with Claude Code",
  "primary_language": "Shell",
  "languages": [
    "shell"
  ],
  "runtime_extras": [],
  "runtime_versions": {},
  "dockerfile_base": "",
  "system_packages": [],
  "extra_binaries": [],
  "global_js_packages": [],
  "dockerfile_python_installs": [],
  "dockerfile_go_installs": [],
  "libraries": {
    "node": [],
    "python": [],
    "go": [],
    "rust": []
  },
  "ports": {
    "inbound": [
      8888
    ]
  },
  "external_services": {
    "domains": [
      "github.com"
    ],
    "source": "source_scan"
  },
  "env_vars": [
    "CLAUDE_CONFIG_DIR",
    "NODE_OPTIONS",
    "SSH_AUTH_SOCK"
  ],
  "browser_tools": [],
  "github_api_usage": false,
  "container": {
    "capabilities": [
      "NET_ADMIN",
      "NET_RAW"
    ],
    "volumes": [
      {
        "name": "claude-code-bashhistory-${devcontainerId}",
        "target": "/commandhistory",
        "type": "volume"
      },
      {
        "name": "claude-code-config-${devcontainerId}",
        "target": "/home/claude/.claude",
        "type": "volume"
      },
      {
        "name": "${localEnv:HOME}/Downloads/ClaudeFiles/SharedFiles",
        "target": "/home/claude/data",
        "type": "bind",
        "consistency": "cached"
      },
      {
        "name": "${localEnv:HOME}/Downloads/ClaudeFiles/Config/gh_claude_ed25519",
        "target": "/run/credentials/gh_claude_ed25519",
        "type": "bind",
        "readonly": true
      },
      {
        "name": "${localEnv:HOME}/Downloads/ClaudeFiles/Config/gh_pat",
        "target": "/run/credentials/gh_pat",
        "type": "bind",
        "readonly": true
      }
    ],
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "CLAUDE_CONFIG_DIR": "/home/claude/.claude",
      "SSH_AUTH_SOCK": "/home/claude/.ssh/agent.sock"
    },
    "remote_user": "claude",
    "post_start": "sudo /usr/local/bin/init-firewall.sh && /workspace/.devcontainer/scripts/init-ssh.sh && /workspace/.devcontainer/scripts/init-gh-token.sh && /workspace/.devcontainer/scripts/init-github-mcp.sh && /workspace/.devcontainer/scripts/load-projects.sh -live sun2admin/builder-project",
    "post_create": "",
    "post_attach": "bash --login -c 'cd $(cat ~/live-project 2>/dev/null || echo ~) && claude --dangerously-skip-permissions'",
    "post_start_chain": [
      {
        "raw": "sudo /usr/local/bin/init-firewall.sh",
        "sudo": true,
        "script": "/usr/local/bin/init-firewall.sh",
        "args": "",
        "in_repo": false
      },
      {
        "raw": "/workspace/.devcontainer/scripts/init-ssh.sh",
        "sudo": false,
        "script": ".devcontainer/scripts/init-ssh.sh",
        "args": "",
        "in_repo": true
      },
      {
        "raw": "/workspace/.devcontainer/scripts/init-gh-token.sh",
        "sudo": false,
        "script": ".devcontainer/scripts/init-gh-token.sh",
        "args": "",
        "in_repo": true
      },
      {
        "raw": "/workspace/.devcontainer/scripts/init-github-mcp.sh",
        "sudo": false,
        "script": ".devcontainer/scripts/init-github-mcp.sh",
        "args": "",
        "in_repo": true
      },
      {
        "raw": "/workspace/.devcontainer/scripts/load-projects.sh -live sun2admin/builder-project",
        "sudo": false,
        "script": ".devcontainer/scripts/load-projects.sh",
        "args": "-live sun2admin/builder-project",
        "in_repo": true
      }
    ],
    "post_create_chain": [],
    "init_scripts": [
      ".devcontainer/scripts/init-gh-token.sh",
      ".devcontainer/scripts/init-github-mcp.sh",
      ".devcontainer/scripts/init-ssh.sh",
      ".devcontainer/scripts/load-projects.sh"
    ],
    "extensions": [
      "anthropic.claude-code",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "eamodio.gitlens",
      "ms-toolsai.jupyter"
    ],
    "vscode_settings": {
      "claudeCode.useTerminal": true,
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "terminal.integrated.defaultProfile.linux": "bash"
    },
    "workspace_mount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
    "workspace_folder": "/workspace",
    "wait_for": "postStartCommand",
    "shutdown_action": "stopContainer"
  },
  "credentials_required": {
    "api_keys": [],
    "tokens": [
      "GITHUB_TOKEN"
    ],
    "ssh": true,
    "other": []
  },
  "mcp_servers": [],
  "claude_plugins": [],
  "inferred": {
    "tools": [
