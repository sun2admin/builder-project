{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sun2admin/builder-project/build-input.schema.json",
  "title": "build-stack input schema",
  "description": "Contract between /build-stack skill and build-stack tool",
  "type": "object",
  "required": [
    "schema_version",
    "build_category",
    "build_project",
    "project_repo",
    "ai_clis"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "build_category": {
      "description": "Top-level builds/<category>/ namespace. Default: project_repo owner OR gh user (sandbox).",
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "minLength": 1,
      "maxLength": 64
    },
    "build_project": {
      "description": "builds/<category>/<project>/ leaf dir name.",
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "minLength": 1,
      "maxLength": 64
    },
    "project_repo": {
      "description": "owner/repo, or null for sandbox (no project repo).",
      "oneOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        { "type": "null" }
      ]
    },
    "use_recommended_l3": {
      "description": "When true, base the stack on the recommended L3 image (recommended-plugins.json baked in). When false, base on L2 directly and install all chosen plugins via devcontainer features.",
      "type": "boolean",
      "default": false
    },
    "plugin_selections": {
      "description": "Marketplace-resolved plugins selected via the shared selector flow. Each entry is analyzed individually via `analyze-plugin <marketplace> <plugin>` (sparse-checkout per Q3). When use_recommended_l3 is true, recommended plugins are excluded from this list (they ride the baked image instead).",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["marketplace", "plugin"],
        "additionalProperties": false,
        "properties": {
          "marketplace": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
          },
          "plugin": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "ai_clis": {
      "description": "Ordered list of AI CLIs. ai_clis[0] is the primary (baked into L2 image); ai_clis[1+] install via L4 init scripts.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["claude", "gemini"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_image": {
          "description": "L1 variant override; null = auto-pick.",
          "oneOf": [
            { "type": "string", "enum": ["light", "latest", "playwright_with_chromium", "playwright_with_firefox", "playwright_with_safari"] },
            { "type": "null" }
          ]
        },
        "additional_l4_features": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "credentials_delivery": {
          "description": "Per-credential delivery override. Default: containerEnv passthrough.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["containerEnv", "mount"]
          }
        }
      }
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "last_modified": {
      "type": "string",
      "format": "date-time"
    }
  }
}
